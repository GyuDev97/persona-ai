# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Cost estimate per 1M tokens (USD) for the model above; used for budget limits.
GYUNEXUS_PRICE_IN_PER_M=0.15
GYUNEXUS_PRICE_OUT_PER_M=0.60

# Autonomous workspace
GYUNEXUS_AUTONOMOUS_ENABLED=true
GYUNEXUS_DEBATE_INTERVAL_MINUTES=180
GYUNEXUS_DAILY_BUDGET_USD=0.50

# Your location, used for weather in proactive suggestions (example: Seoul)
GYUNEXUS_TIMEZONE=Asia/Seoul
GYUNEXUS_LATITUDE=37.5665
GYUNEXUS_LONGITUDE=126.9780

# Default is SQLite at data/gyunexus.db. For MariaDB: pip install -e ".[mariadb]" and set e.g.
# GYUNEXUS_DATABASE_URL=mariadb+pymysql://user:pass@localhost:3306/gyunexus?charset=utf8mb4
