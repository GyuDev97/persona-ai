# Local webcam posture monitor. Keep actual values in posture_monitor/.env only.
POSTURE_CAMERA_INDEX=0
POSTURE_CAMERA_WIDTH=640
POSTURE_CAMERA_HEIGHT=480
POSTURE_FRAME_SKIP=3
POSTURE_CAMERA_RECONNECT_SECONDS=5
POSTURE_POSE_DETECTION_CONFIDENCE=0.6
POSTURE_POSE_TRACKING_CONFIDENCE=0.6

# Run calibration while sitting in a normal, comfortable posture.
POSTURE_CALIBRATION_SECONDS=5
POSTURE_BAD_DURATION_SECONDS=12
POSTURE_COOLDOWN_SECONDS=1500
POSTURE_API_FAILURE_BACKOFF_SECONDS=60
POSTURE_FORWARD_HEAD_DELTA=0.18
POSTURE_HEAD_DOWN_ANGLE_DELTA_DEGREES=16
POSTURE_WARNING_RATIO=0.65
POSTURE_SMOOTHING_ALPHA=0.28

POSTURE_API_URL=http://127.0.0.1:8000/api/events/posture-warning
POSTURE_API_TOKEN=replace_with_the_posture_api_token
POSTURE_API_TIMEOUT_SECONDS=5

# Confirmed BAD posture flashes the primary screen red before the TTS request.
POSTURE_SCREEN_ALERT_ENABLED=1
POSTURE_SCREEN_ALERT_PULSES=4
POSTURE_SCREEN_ALERT_OPACITY=0.82
POSTURE_SCREEN_ALERT_INTERVAL_MS=250
