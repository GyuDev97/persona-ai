# A laptop only. Do not commit this file after copying it to .env.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FRAME_SKIP=3
CAMERA_RECONNECT_SECONDS=5

# Start on CPU. Change to gpu only after installing onnxruntime-gpu and
# confirming the MX450 CUDA runtime works.
FACE_PROVIDER=cpu
FACE_DETECTION_SIZE=640
FACE_MATCH_THRESHOLD=0.45
REQUIRED_MATCH_FRAMES=4
COOLDOWN_SECONDS=600
API_FAILURE_BACKOFF_SECONDS=60

# B laptop's LAN address, not 127.0.0.1.
API_URL=http://192.168.0.10:8000/api/events/home-arrival
API_TOKEN=replace_with_the_same_core_token
API_TIMEOUT_SECONDS=5
