OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini

DB_BACKEND=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=personal_life

GYUVIS_TTS_BACKEND=edge
GYUVIS_TTS_ALLOW_FALLBACK=0
GYUVIS_EDGE_TTS_VOICE=ko-KR-InJoonNeural
GYUVIS_EDGE_TTS_RATE=+12%
GYUVIS_EDGE_TTS_PITCH=-8Hz

GYUVIS_EVENING_BRIEFING=1
GYUVIS_EVENING_START_HOUR=18
GYUVIS_EVENING_GREETING=안녕하세요 보스. 오늘 하루도 고생하셨습니다. 저녁 브리핑을 진행해드릴까요?
GYUVIS_EVENING_BRIEFING_ACK=알겠습니다, 보스.
GYUVIS_SOCIAL_CLOSE_ACK=네 보스. 감사합니다. 필요하시면 언제든 다시 불러주십시오.
GYUVIS_INTRO_REPLY=안녕하세요. 저는 보스의 로컬 퍼스널 AI 시스템, 규비스입니다. 일정과 브리핑, 에이전트 상태 확인, 브라우저와 PC 작업 보조를 맡고 있습니다. 지금은 아직 성장 중이지만, 보스가 말하면 바로 움직이는 개인 비서가 되는 중입니다.

# GYUVIS_JARVIS_HUD_PATH=D:\github\persona-ai\apps\javis-app\standby-v2.html
GYUVIS_HUD_FULLSCREEN_MODE=kiosk
# GYUVIS_HUD_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

GYUVIS_AGENT1_START_TIME=06:00
GYUVIS_AGENT1_END_TIME=23:00
GYUVIS_AGENT1_COLLECT_INTERVAL_SECONDS=600
GYUVIS_AGENT1_ON_DUTY_MESSAGE=Agent 01 출근했습니다. 오늘도 IT 뉴스 수집 시작하겠습니다.
GYUVIS_AGENT1_OFF_DUTY_MESSAGE=오늘 수집 시간 종료했습니다. 최종 보고까지 정리했으니 Agent 01은 이만 퇴근하겠습니다.
GYUVIS_AGENT2_AUTO_DRAFT_FROM_AGENT1=1
GYUVIS_AGENT2_STANDBY_MESSAGE=블로그 초안 #{draft_id} 작성 완료했습니다. 발행은 하지 않고 다시 대기하겠습니다.
GYUVIS_AGENT3_STANDBY_MESSAGE=Codex 작업 요청 확인 완료했습니다. 자동 수정은 하지 않고 다시 대기하겠습니다.
GYUVIS_AGENT3_QUEUE_STANDBY_MESSAGE=Codex 작업 큐 #{task_id} 등록 완료했습니다. 사용자 수동 검토 전까지 대기하겠습니다.
GYUVIS_AGENT4_AUTO_IDEA_FROM_AGENT1=1
GYUVIS_AGENT4_STANDBY_MESSAGE=유튜브 아이디어 후보 {idea_count}개 정리했습니다. 다음 자료가 들어올 때까지 대기하겠습니다.

GYUVIS_NEWS_EMAIL_ENABLED=0
GYUVIS_AGENT1_NEWS_EMAIL_TIME=08:00
GYUVIS_NEWS_EMAIL_LIMIT=8
GYUVIS_NAVER_SMTP_HOST=smtp.naver.com
GYUVIS_NAVER_SMTP_PORT=587
GYUVIS_NAVER_EMAIL_USERNAME=your_naver_id@naver.com
GYUVIS_NAVER_EMAIL_PASSWORD=your_naver_smtp_password
GYUVIS_NEWS_EMAIL_TO=your_naver_id@naver.com
GYUVIS_NEWS_EMAIL_FROM=your_naver_id@naver.com
GYUVIS_NEWS_EMAIL_SUBJECT=[GyuOS] 오늘의 IT 뉴스 브리핑

GYUVIS_NAVER_BLOG_URL=https://blog.naver.com

GYUVIS_FOLLOWUP_RECORD_SECONDS=8
GYUVIS_FOLLOWUP_MAX_RECORD_SECONDS=14
GYUVIS_FOLLOWUP_SILENCE_SECONDS=1.2
GYUVIS_FOLLOWUP_VOICE_THRESHOLD=0.018
